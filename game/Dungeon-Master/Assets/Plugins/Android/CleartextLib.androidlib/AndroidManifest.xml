<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.dungeonmaster.cleartextlib">
  <!-- Dev only: allow cleartext HTTP so device builds can reach the level
       generator on the dev PC (http://127.0.0.1:8124 via "adb reverse").
       Library manifests MERGE into Unity's default main manifest, so this
       adds only the flag without touching the launcher activity, theme, or
       anything else. (A main-manifest override at Plugins/Android/
       AndroidManifest.xml REPLACES Unity's default and previously dropped
       the launcher entry, then crashed on a wrong theme — do not go back
       to that.) Remove for release / hosted builds (https).
       See docs/android-build.md. -->
  <application android:usesCleartextTraffic="true" />
</manifest>
